# ---------------------------------------------------------------------------
# 复制为 .env 后填写。所有变量都有合理默认值，不填也能以 offline 模式跑通 demo。
# ---------------------------------------------------------------------------

# LLM（OpenAI 兼容接口）。默认走 DeepSeek，也可换成任意兼容网关。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 是否强制离线：true 时所有 server 只读本地 fixture，不发任何网络请求。
# 用于在没有外网 / 需要稳定复现的环境下演示。
MINING_BRIEF_OFFLINE=false

# 缓存目录与 TTL（秒）
MINING_BRIEF_CACHE_DIR=data/cache
MINING_BRIEF_CACHE_TTL=3600

# 网络请求超时（秒）
MINING_BRIEF_HTTP_TIMEOUT=20

# 自定义 UA。爬取公开页面时请遵守目标站点的 robots.txt 与使用条款。
MINING_BRIEF_USER_AGENT=mining-brief-mcp/0.1 (+https://github.com/ding16-ai/mining-brief-mcp)

# 默认使用的 NI 43-101 技术报告 PDF（http(s) URL 或本地绝对路径）。
# 留空时 Agent 会跳过储量抽取并在简报的「数据降级说明」中标注。
# 公开报告可从 SEDAR+（https://www.sedarplus.ca/）或公司官网 Investor 页面获取。
MINING_BRIEF_DEFAULT_PDF=
