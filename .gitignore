*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

.env

# Claude Code 的个人设置。Claude Code 首次写入该文件时会自动把它加进全局
# gitignore，但手动创建的不会 —— 所以在这里显式排除。
.claude/settings.local.json

# 运行时缓存与下载物（保留目录，忽略内容）
data/cache/
data/pdfs/
!data/cache/.gitkeep
!data/pdfs/.gitkeep

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# 生成的简报（示例输出请手动挑选后提交）
out/
*.local.md
